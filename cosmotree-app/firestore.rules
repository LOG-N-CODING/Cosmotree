rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자 권한 확인 함수
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == 1;
    }
    
    // 사용자는 자신의 데이터만 읽기/쓰기 가능
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 공개적으로 읽기만 허용할 데이터 (관리자는 모든 권한)
    match /modules/{moduleId} {
      allow read: if true; // 누구나 읽기 가능
      allow write: if request.auth != null; // 로그인한 사용자만 쓰기 가능
      allow delete: if isAdmin(); // 관리자만 삭제 가능
    }
    
    match /modules/{moduleId}/lessons/{lessonId} {
      allow read: if true; // 누구나 읽기 가능
      allow write: if request.auth != null; // 로그인한 사용자만 쓰기 가능
      allow delete: if isAdmin(); // 관리자만 삭제 가능
    }
    
    match /lessons/{lessonId} {
      allow read: if true; // 누구나 읽기 가능
      allow write: if request.auth != null; // 로그인한 사용자만 쓰기 가능
      allow delete: if isAdmin(); // 관리자만 삭제 가능
    }
    
    // 퀴즈 관련 데이터
    match /quizzes/{quizId} {
      allow read: if true; // 누구나 읽기 가능
      allow write: if request.auth != null; // 로그인한 사용자만 쓰기 가능
      allow delete: if isAdmin(); // 관리자만 삭제 가능
    }
    
    // 퀴즈 결과는 사용자별로 관리
    match /quiz_results/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 기타 모든 문서에 대해서는 접근 금지 (단, 관리자는 모든 권한)
    match /{document=**} {
      allow read, write, delete: if isAdmin();
    }
  }
}
